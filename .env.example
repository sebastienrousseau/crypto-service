# Crypto Service Suite — Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ── Server ──────────────────────────────────────────────────────────
# Host and port for the Fastify server
HOST=localhost
PORT=3000
PROTOCOL=http

# ── Authentication ──────────────────────────────────────────────────
# JWT secret for Bearer token authentication (HS256), at least 32 bytes.
# Every token must carry exp and iat.
JWT_SECRET=

# Maximum token lifetime in seconds (default 3600): a token must be
# younger than this and must not declare a longer exp - iat.
JWT_MAX_AGE=

# Required iss and aud claims. Required in production when JWT_SECRET is
# set, so a token minted for another service sharing the secret is refused.
JWT_ISSUER=
JWT_AUDIENCE=

# Static API key for x-api-key header authentication
CRYPTO_API_KEY=

# With neither credential set, every request is refused (401), and
# NODE_ENV=production refuses to start. Set ALLOW_ANONYMOUS=1 only for
# local development or behind a gateway that authenticates for you.
ALLOW_ANONYMOUS=

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave unset to disable CORS.
CORS_ORIGIN=

# ── Trusted Proxies ────────────────────────────────────────────────
# Comma-separated CIDR ranges for trusted reverse proxies
TRUSTED_PROXY_CIDRS=

# ── Key Storage ─────────────────────────────────────────────────────
# Directory containing the signing keystore (rsa.key, rsa.pub, rsa.cert).
# Required in production: the keys bundled with the package are public
# test fixtures.
CRYPTO_KEY_DIR=

# Directory for generated key output. The v2 key-generation routes keep
# private keys on the server and return a keyId; when this is set, each
# key is also written here as <keyId>.json (mode 0600, unencrypted) so it
# survives a restart. When unset, keys live in memory only.
CRYPTO_KEY_OUT_DIR=

# ── Logging ─────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── OpenTelemetry ───────────────────────────────────────────────────
# OTLP endpoint for traces and metrics. Leave unset to disable telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=
