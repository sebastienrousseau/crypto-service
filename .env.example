# Crypto Service Suite — Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ── Server ──────────────────────────────────────────────────────────
# Host and port for the Fastify server
HOST=localhost
PORT=3000
PROTOCOL=http

# ── Authentication ──────────────────────────────────────────────────
# JWT secret for Bearer token authentication (HS256)
# Leave unset (along with CRYPTO_API_KEY) to allow anonymous access in dev mode.
JWT_SECRET=

# Static API key for x-api-key header authentication
CRYPTO_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave unset to disable CORS.
CORS_ORIGIN=

# ── Trusted Proxies ────────────────────────────────────────────────
# Comma-separated CIDR ranges for trusted reverse proxies
TRUSTED_PROXY_CIDRS=

# ── Key Storage ─────────────────────────────────────────────────────
# Directory containing input key files
CRYPTO_KEY_DIR=

# Directory for generated key output
CRYPTO_KEY_OUT_DIR=

# ── Logging ─────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── OpenTelemetry ───────────────────────────────────────────────────
# OTLP endpoint for traces and metrics. Leave unset to disable telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=
