{
    "description": "The Crypto Service Suite is a powerful and intuitive suite of security tools that provides numerous Cryptographic JavaScript functions and standardized REST APIs to manage encryption keys, perform common cryptographic operations such as key generation, data encryption, digital signing, and signature verification.",
    "engines": {
        "node": ">=20.18"
    },
    "homepage": "https://crypto-service.co",
    "license": "MIT",
    "license_URI": "http://www.opensource.org/licenses/mit-license.php",
    "name": "@sebastienrousseau/crypto-service",
    "private": true,
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "prepare": "husky install",
        "build": "pnpm -r run build",
        "clean": "pnpm -r run clean",
        "docs": "pnpm -r run docs",
        "lint:fix": "pnpm -r run lint:fix",
        "lint": "pnpm -r run lint",
        "format": "pnpm -r run format",
        "release:prepare": "pnpm -r run release:prepare",
        "release:publish": "pnpm -r run release:publish",
        "release": "pnpm install && pnpm run release:prepare && pnpm run release:publish",
        "start:crypto-server": "pnpm --filter @sebastienrousseau/crypto-server run start",
        "start": "pnpm -r run start",
        "test": "pnpm -r run test"
    },
    "version": "0.0.3",
    "devDependencies": {
        "eslint-plugin-prettier": "^5.0.0",
        "husky": "^8.0.3",
        "mkdirp": "^3.0.1",
        "rimraf": "^5.0.5",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2"
    },
    "pnpm": {
        "overrides": {
            "fast-jwt@<6.2.0": "^6.2.0",
            "minimatch@<9.0.7": "^9.0.7",
            "serialize-javascript@<7.0.5": "^7.0.5",
            "diff@<8.0.3": "^8.0.3"
        }
    }
}
