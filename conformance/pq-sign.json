{
  "group": "pq-sign",
  "description": "ML-DSA (FIPS 204), SLH-DSA (FIPS 205) and the ISO 20022 dual-signature check. The envelope is fixed, signed with synthetic keys.",
  "vectors": [
    {
      "id": "ml-dsa-keygen",
      "description": "A server-held ML-DSA-44 key.",
      "request": {
        "method": "POST",
        "path": "/v2/pq/dsa/keygen",
        "body": {
          "level": 44
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "keyId": {
              "$shape": {
                "type": "string",
                "pattern": "^k_[A-Za-z0-9_-]{22}$"
              }
            },
            "algorithm": "ml-dsa-44",
            "publicKey": {
              "$shape": {
                "type": "string",
                "pattern": "^[0-9a-f]{2624}$"
              }
            }
          }
        }
      },
      "capture": {
        "dsaKeyId": "/data/keyId",
        "dsaPub": "/data/publicKey"
      }
    },
    {
      "id": "ml-dsa-sign",
      "description": "Sign with it.",
      "request": {
        "method": "POST",
        "path": "/v2/pq/dsa/sign",
        "body": {
          "keyId": "${dsaKeyId}",
          "message": "conformance"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "signature": {
              "$shape": {
                "type": "string",
                "pattern": "^[0-9a-f]{4840}$"
              }
            },
            "algorithm": "ml-dsa-44"
          }
        }
      },
      "capture": {
        "dsaSig": "/data/signature"
      }
    },
    {
      "id": "ml-dsa-verify",
      "description": "The signature verifies.",
      "request": {
        "method": "POST",
        "path": "/v2/pq/dsa/verify",
        "body": {
          "level": 44,
          "publicKey": "${dsaPub}",
          "message": "conformance",
          "signature": "${dsaSig}"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "valid": true,
            "algorithm": "ml-dsa-44"
          }
        }
      }
    },
    {
      "id": "ml-dsa-verify-other-message",
      "description": "Not over another message.",
      "request": {
        "method": "POST",
        "path": "/v2/pq/dsa/verify",
        "body": {
          "level": 44,
          "publicKey": "${dsaPub}",
          "message": "other",
          "signature": "${dsaSig}"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "valid": false,
            "algorithm": "ml-dsa-44"
          }
        }
      }
    },
    {
      "id": "slh-dsa-keygen",
      "description": "A server-held SLH-DSA-SHA2-128f key.",
      "request": {
        "method": "POST",
        "path": "/v2/pq/slh-dsa/keygen",
        "body": {
          "variant": "sha2-128f"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "keyId": {
              "$shape": {
                "type": "string",
                "pattern": "^k_[A-Za-z0-9_-]{22}$"
              }
            },
            "algorithm": "slh-dsa-sha2-128f",
            "publicKey": {
              "$shape": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "capture": {
        "slhKeyId": "/data/keyId",
        "slhPub": "/data/publicKey"
      }
    },
    {
      "id": "slh-dsa-sign",
      "description": "Sign with it.",
      "request": {
        "method": "POST",
        "path": "/v2/pq/slh-dsa/sign",
        "body": {
          "keyId": "${slhKeyId}",
          "message": "conformance"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "signature": {
              "$shape": {
                "type": "string",
                "pattern": "^[0-9a-f]{34176}$"
              }
            },
            "algorithm": "slh-dsa-sha2-128f"
          }
        }
      },
      "capture": {
        "slhSig": "/data/signature"
      }
    },
    {
      "id": "slh-dsa-verify",
      "description": "The signature verifies.",
      "request": {
        "method": "POST",
        "path": "/v2/pq/slh-dsa/verify",
        "body": {
          "variant": "sha2-128f",
          "publicKey": "${slhPub}",
          "message": "conformance",
          "signature": "${slhSig}"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "valid": true,
            "algorithm": "slh-dsa-sha2-128f"
          }
        }
      }
    },
    {
      "id": "iso20022-valid",
      "description": "A fixed pacs.008 envelope verifies against its signer's keys.",
      "request": {
        "method": "POST",
        "path": "/v2/stream/iso20022",
        "body": {
          "envelope": {
            "messageId": "CONF-1",
            "messageType": "pacs.008",
            "payloadDigest": "df280c12e2a5c328741d4d81c68c6d0120218c8987b035b032fc1bece7734af6",
            "digestAlgorithm": "sha256",
            "timestamp": "2026-11-15T11:03:17.270Z",
            "classical": {
              "algorithm": "ed25519",
              "signature": "04581a4850411f4ba064415de783f412e869bfd1d7afbf097310d80201be242c85bba7d171b394a052a26f03acbdf685e7f1157883bb3201ee97c8d334774007",
              "publicKey": "914f32d3c959cac95fb28a3e9f989477f4d5c9812284efd20fc3a448030c3e1a"
            },
            "postQuantum": {
              "algorithm": "ml-dsa-44",
              "signature": "",
              "publicKey": ""
            }
          },
          "payload": {
            "GrpHdr": {
              "MsgId": "CONF-1"
            },
            "Amt": 100,
            "Ccy": "EUR"
          },
          "trustedKeys": {
            "classicalPublicKey": "914f32d3c959cac95fb28a3e9f989477f4d5c9812284efd20fc3a448030c3e1a",
            "postQuantumPublicKey": ""
          }
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "valid": true,
            "digestMatches": true,
            "classicalValid": true,
            "postQuantumValid": true,
            "messageId": "CONF-1"
          }
        }
      }
    },
    {
      "id": "iso20022-tampered",
      "description": "A changed payload breaks the digest.",
      "request": {
        "method": "POST",
        "path": "/v2/stream/iso20022",
        "body": {
          "envelope": {
            "messageId": "CONF-1",
            "messageType": "pacs.008",
            "payloadDigest": "df280c12e2a5c328741d4d81c68c6d0120218c8987b035b032fc1bece7734af6",
            "digestAlgorithm": "sha256",
            "timestamp": "2026-11-15T11:03:17.270Z",
            "classical": {
              "algorithm": "ed25519",
              "signature": "04581a4850411f4ba064415de783f412e869bfd1d7afbf097310d80201be242c85bba7d171b394a052a26f03acbdf685e7f1157883bb3201ee97c8d334774007",
              "publicKey": "914f32d3c959cac95fb28a3e9f989477f4d5c9812284efd20fc3a448030c3e1a"
            },
            "postQuantum": {
              "algorithm": "ml-dsa-44",
              "signature": "",
              "publicKey": ""
            }
          },
          "payload": {
            "GrpHdr": {
              "MsgId": "CONF-1"
            },
            "Amt": 1,
            "Ccy": "EUR"
          },
          "trustedKeys": {
            "classicalPublicKey": "914f32d3c959cac95fb28a3e9f989477f4d5c9812284efd20fc3a448030c3e1a",
            "postQuantumPublicKey": ""
          }
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "valid": false,
            "digestMatches": false,
            "classicalValid": true,
            "postQuantumValid": true,
            "messageId": "CONF-1"
          }
        }
      }
    }
  ]
}
