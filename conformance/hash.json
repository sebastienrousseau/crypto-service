{
  "group": "hash",
  "description": "Digests of fixed input; every expected value is exact.",
  "vectors": [
    {
      "id": "hash-sha256-abc",
      "description": "sha256 of the UTF-8 bytes of \"abc\" (expected value from OpenSSL).",
      "request": {
        "method": "POST",
        "path": "/v2/hash",
        "body": {
          "algorithm": "sha256",
          "data": "abc"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "digest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
            "algorithm": "sha256",
            "length": 32
          }
        }
      }
    },
    {
      "id": "hash-sha384-abc",
      "description": "sha384 of the UTF-8 bytes of \"abc\" (expected value from OpenSSL).",
      "request": {
        "method": "POST",
        "path": "/v2/hash",
        "body": {
          "algorithm": "sha384",
          "data": "abc"
        }
      },
      "expect": {
        "status": 200,
        "mediaType": "application/json",
        "body": {
          "data": {
            "digest": "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
            "algorithm": "sha384",
            "length": 48
          }
        }
      }
    },
    {
      "id": "hash-sha512-abc",
      "description": "sha512 of the UTF-8 bytes of \"abc\" (expected value from OpenSSL).",
      "request": {
        "method": "POST",
        "path": "/v2/hash",
        "body": {
          "algorithm": "sha512",
          "data": "abc"
        }
      },
      "expect": {
        "status": 200,
