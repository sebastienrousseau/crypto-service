    {
      "id": "hash-unknown-algorithm",
      "description": "An algorithm outside the enum fails validation (400, not 422).",
      "request": {
        "method": "POST",
        "path": "/v2/hash",
        "body": {
          "algorithm": "md5",
          "data": "abc"
        }
      },
      "expect": {
        "status": 400,
        "mediaType": "application/problem+json",
        "body": {
          "type": "urn:crypto-service:problem:validation-failed",
          "title": "Validation failed",
          "status": 400,
          "detail": {
            "$shape": {
              "type": "string"
            }
          },
          "instance": "/v2/hash",
          "errors": [
            {
              "field": "/algorithm",
              "message": {
                "$shape": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
