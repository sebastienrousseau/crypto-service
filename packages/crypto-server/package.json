{
  "name": "@sebastienrousseau/crypto-server",
  "version": "0.0.3",
  "description": "Crypto Server is a Fastify web server that exposes easy consumable REST APIs to perform low-level cryptographic operations.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://crypto-server.io",
  "repository": {
    "directory": "packages/crypto-server",
    "type": "git",
    "url": "git@github.com:sebastienrousseau/crypto-service.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/crypto-service/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "crypto-server": "dist/src/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --cache --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "start": "node dist/src/index.js",
    "test": "c8 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc"
  },
  "dependencies": {
    "@fastify/accepts": "^4.2.0",
    "@fastify/compress": "^6.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/etag": "^4.2.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^8.0.3",
    "@fastify/swagger": "^8.12.0",
    "@fastify/swagger-ui": "^1.10.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation-fastify": "^0.44.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@fastify/jwt": "^9.0.0",
    "fastify": "^4.28.0",
    "fastify-healthcheck": "^4.4.0",
    "openpgp": "^5.11.0",
    "uuid": "^10.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@sebastienrousseau/crypto-lib": "workspace:*",
    "@types/chai": "^4.3.7",
    "@types/chai-as-promised": "^7.1.6",
    "@types/mocha": "^10.0.2",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "c8": "^10.1.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^10.8.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "crypto-service",
    "cryptography",
    "encryption",
    "decryption",
    "openpgp",
    "fastify",
    "rest-api"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
