{
  "name": "@sebastienrousseau/crypto-wasm",
  "version": "0.0.3",
  "description": "WebAssembly performance accelerator for crypto-lib — near-native speed for heavy cryptographic operations.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "wasm/"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "build:wasm": "echo 'WASM build requires Rust toolchain — see README'",
    "clean": "rimraf ./coverage ./dist ./docs",
    "test": "c8 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --cache --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "devDependencies": {
    "@types/chai": "^4.3.7",
    "@types/chai-as-promised": "^7.1.6",
    "@types/mocha": "^10.0.2",
    "@types/node": "^22.0.0",
    "c8": "^10.1.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^10.8.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.0",
    "typescript": "^5.7.0"
  },
  "homepage": "https://github.com/sebastienrousseau/crypto-service/tree/main/packages/crypto-wasm",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
