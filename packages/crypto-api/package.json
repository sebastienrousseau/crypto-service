{
    "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
    "autoupdate": {
        "fileMap": [
            {
                "basePath": "dist",
                "files": [
                    "**/*"
                ]
            }
        ],
        "source": "git",
        "target": "git://github.com/sebastienrousseau/crypto-service.git"
    },
    "bin": {
        "cryptoapi": "dist/index.js"
    },
    "bugs": {
        "url": "https://github.com/sebastienrousseau/crypto-service/issues"
    },
    "description": "Internal documentation tooling for the Crypto Service Suite. Converts a Postman collection JSON file to markdown reference docs. NOTE: this package contains no cryptographic code despite its `crypto-api` name (kept for historical/import-path stability). Marked `private: true` so it cannot be accidentally published.",
    "dependencies": {
        "minimist": "^1.2.8"
    },
    "files_note": "Internal tool only — NOT published. See `private: true` below. The historical name is preserved to avoid breaking the `@sebastienrousseau/crypto-api` import path used by repo tooling. A future rename to `@sebastienrousseau/postman-doc-gen` is the cleaner long-term fix.",
    "devDependencies": {
        "@sebastienrousseau/c8-config": "^0.0.3",
        "@sebastienrousseau/eslint-config": "^0.0.2",
        "@sebastienrousseau/jsdoc-config": "^0.0.5",
        "@sebastienrousseau/markdownlint-config": "^0.0.1",
        "@sebastienrousseau/mocha-config": "^0.0.5",
        "@sebastienrousseau/prettier-config": "^0.0.4",
        "@sebastienrousseau/remark-config": "^0.0.3",
        "@types/chai": "^4.3.7",
        "@types/chai-as-promised": "^7.1.6",
        "@types/minimist": "^1.2.5",
        "@types/mocha": "^10.0.2",
        "@types/node":"^20.8.4",
        "@typescript-eslint/eslint-plugin": "^6.7.5",
        "@typescript-eslint/parser": "^6.7.5",
        "c8": "^10.1.3",
        "chai": "^4.3.10",
        "chai-as-promised": "^7.1.1",
        "eslint": "^8.51.0",
        "eslint-import-resolver-typescript": "^3.6.1",
        "eslint-plugin-import": "^2.28.1",
        "filesizes": "^0.1.2",
        "mocha": "^11.1.0",
        "prettier": "^3.0.3",
        "remark-cli": "^12.0.0",
        "remark-footnotes": "^4.0.1",
        "remark-preset-lint-consistent": "^5.1.2",
        "remark-preset-lint-markdown-style-guide": "^5.1.3",
        "remark-preset-lint-recommended": "^6.1.3",
        "rimraf": "^5.0.5",
        "ts-node": "^10.9.1",
        "typedoc": "^0.25.2",
        "typedoc-plugin-missing-exports": "^2.1.0",
        "typescript": "^5.2.2"
    },
    "directories": {
        "src": "./src",
        "test": "__tests__"
    },
    "engines": {
        "node": ">=20.18"
    },
    "files": [
        "dist/**/*"
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/sebastienrousseau"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/wwdseb"
        }
    ],
    "homepage": "https://crypto-api.io",
    "keywords": [
        "crypto-api"
    ],
    "license": "MIT",
    "license_URI": "http://www.opensource.org/licenses/mit-license.php",
    "main": "./dist/index.js",
    "name": "@sebastienrousseau/crypto-api",
    "private": true,
    "repository": {
        "directory": "packages/crypto-api",
        "type": "git",
        "url": "git@github.com:sebastienrousseau/crypto-service.git"
    },
    "scripts": {
        "build": "tsc --build tsconfig.json && pnpm run copy:docs && pnpm run copy:coll && pnpm run copy:env && pnpm run copy:makefile && pnpm run copy:package && pnpm run copy:copyright && pnpm run filesize:distribution",
        "clean": "rimraf ./coverage ./dist ./docs ./node_modules",
        "copy:copyright": "cp COPYRIGHT dist/",
        "copy:docs": "mkdirp dist/docs && cp ./src/docs/* dist/docs",
        "copy:coll": "mkdirp dist/collections && cp ./src/collections/* dist/collections",
        "copy:env": "mkdirp dist/environments && cp ./src/environments/* dist/environments",
        "copy:license": "cp LICENSE dist/",
        "copy:makefile": "cp Makefile dist/",
        "copy:package": "cp package.json dist/",
        "copy:readme": "cp README.md dist/",
        "docs": "typedoc",
        "filesize:distribution": "filesizes dist/ > dist/report.txt",
        "format": "prettier --write src/**/*.ts",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint --cache --fix src/**/*.ts",
        "markdown": "pnpm remark ./*.md packages/**/*.md --rc-path ./.remarkrc --quiet",
        "prepack": "pnpm run build",
        "release": "pnpm run release:prepare && pnpm run release:publish",
        "release:prepare": "pnpm pack",
        "release:publish": "npm publish --access public --ignore-scripts",
        "start": "node dist/index.js",
        "test": "npx c8 --config=.c8rc --reporter=lcov mocha --config=.mocharc"
    },
    "types": "./dist/index.d.ts",
    "version": "0.0.1"
}
