{
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "autoupdate": {
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "**/*"
        ]
      }
    ],
    "source": "git",
    "target": "git://github.com/sebastienrousseau/crypto-service.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/crypto-service/issues"
  },
  "description": "The Crypto Service Suite APIs are typical REST APIs that use HTTPS requests and responses for common cryptographic operations.",
  "dependencies": {
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@sebastienrousseau/c8-config": "^0.0.7",
    "@sebastienrousseau/eslint-config": "^0.0.7",
    "@sebastienrousseau/jsdoc-config": "^0.0.7",
    "@sebastienrousseau/markdownlint-config": "^0.0.1",
    "@sebastienrousseau/mocha-config": "^0.0.5",
    "@sebastienrousseau/prettier-config": "^0.0.7",
    "@sebastienrousseau/remark-config": "^0.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "filesizes": "^0.1.2",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "remark-cli": "^12.0.0",
    "remark-footnotes": "^5.0.0",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-markdown-style-guide": "^5.1.3",
    "remark-preset-lint-recommended": "^7.0.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "~7.0.2"
  },
  "directories": {
    "src": "./src",
    "test": "__tests__"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/sebastienrousseau"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/wwdseb"
    }
  ],
  "homepage": "https://crypto-api.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/crypto-service.git",
    "directory": "packages/crypto-api"
  },
  "keywords": [
    "crypto-api"
  ],
  "license": "MIT OR Apache-2.0",
  "license_URI": "http://www.opensource.org/licenses/mit-license.php",
  "type": "commonjs",
  "main": "./dist/index.js",
  "name": "@sebastienrousseau/crypto-api",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint --cache --fix src __tests__",
    "start": "node dist/index.js",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "version": "0.0.9"
}
