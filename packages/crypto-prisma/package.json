{
  "name": "@sebastienrousseau/crypto-prisma",
  "version": "0.0.3",
  "description": "Prisma ORM integration for transparent field-level encryption using crypto-lib.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --cache --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@sebastienrousseau/crypto-lib": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/sebastienrousseau/crypto-service/tree/main/packages/crypto-prisma",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
