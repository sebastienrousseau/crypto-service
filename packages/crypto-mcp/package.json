{
  "name": "@sebastienrousseau/crypto-mcp",
  "version": "0.0.8",
  "description": "Model Context Protocol (MCP) server for the Crypto Service Suite — exposing cryptographic operations, post-quantum primitives, and key management to AI assistants and agentic workflows.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "crypto-mcp": "./dist/cli.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint --cache --fix src __tests__",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sebastienrousseau/crypto-lib": "workspace:*",
    "@sebastienrousseau/crypto-kms": "workspace:*",
    "@sebastienrousseau/crypto-wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "mocha": "^12.0.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3"
  },
  "homepage": "https://github.com/sebastienrousseau/crypto-service/tree/main/packages/crypto-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/crypto-service.git",
    "directory": "packages/crypto-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false
}
