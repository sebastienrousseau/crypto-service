{
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "autoupdate": {
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "**/*"
        ]
      }
    ],
    "source": "git",
    "target": "git://github.com/sebastienrousseau/crypto-service.git"
  },
  "type": "commonjs",
  "bin": {
    "crypto-cli": "dist/cli.js",
    "cryptocli": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/crypto-service/issues"
  },
  "dependencies": {
    "@sebastienrousseau/crypto-cbom": "workspace:*",
    "@sebastienrousseau/crypto-kms": "workspace:*",
    "@sebastienrousseau/crypto-lib": "workspace:*",
    "commander": "^15.0.0",
    "figlet": "^1.12.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "description": "The Crypto Lib Command Line Interface (CLI) is a unified tool to perform common cryptographic operations such as key generation, data encryption, digital signing, and signature verification which are invoked from the command prompt or terminal.",
  "devDependencies": {
    "@sebastienrousseau/c8-config": "^0.0.7",
    "@sebastienrousseau/eslint-config": "^0.0.7",
    "@sebastienrousseau/jsdoc-config": "^0.0.7",
    "@sebastienrousseau/markdownlint-config": "^0.0.7",
    "@sebastienrousseau/mocha-config": "^0.0.7",
    "@sebastienrousseau/prettier-config": "^0.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/figlet": "^1.5.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/prompts": "^2.4.5",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "filesizes": "^0.1.2",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "~5.9.3"
  },
  "directories": {
    "src": "./src",
    "test": "__tests__"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/sebastienrousseau"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/wwdseb"
    }
  ],
  "homepage": "https://crypto-cli.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/crypto-service.git",
    "directory": "packages/crypto-cli"
  },
  "keywords": [
    "crypto-cli"
  ],
  "license": "MIT OR Apache-2.0",
  "license_URI": "http://www.opensource.org/licenses/mit-license.php",
  "name": "@sebastienrousseau/crypto-cli",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint --cache --fix src __tests__",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "readme:usage": "node scripts/readme-usage.mjs",
    "start": "node dist/cli.js",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc"
  },
  "sideEffects": false,
  "version": "0.0.29"
}
