{
  "name": "@sebastienrousseau/crypto-middleware",
  "version": "0.0.12",
  "description": "Plug-and-play cryptographic middleware for Express and Fastify -- auto-decrypt requests, verify signatures, and encrypt responses.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://crypto-service.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/crypto-service.git",
    "directory": "packages/crypto-middleware"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/crypto-service/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint --cache --fix src __tests__",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sebastienrousseau/crypto-lib": "workspace:*",
    "fastify-plugin": "^6.0.0"
  },
  "peerDependencies": {
    "express": "^5.2.1",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sebastienrousseau/mocha-config": "^0.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "mocha": "^12.0.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "crypto-middleware",
    "cryptography",
    "express",
    "fastify",
    "encryption",
    "hmac",
    "jwt",
    "middleware"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": false
}
