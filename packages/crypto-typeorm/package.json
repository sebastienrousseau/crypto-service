{
  "name": "@sebastienrousseau/crypto-typeorm",
  "version": "0.0.7",
  "description": "TypeORM column-level encryption with a single decorator, powered by crypto-lib.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc",
    "lint": "eslint --ext .ts src __tests__",
    "lint:fix": "eslint --cache --fix --ext .ts src __tests__",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sebastienrousseau/crypto-lib": "workspace:*"
  },
  "peerDependencies": {
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@sebastienrousseau/mocha-config": "^0.0.5",
    "@types/chai": "^4.3.7",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.2",
    "@types/node": "^26.4.1",
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^10.8.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typeorm": "^1.1.0",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "typeorm",
    "encryption",
    "column-encryption",
    "crypto",
    "decorator",
    "transformer",
    "subscriber",
    "xchacha20-poly1305",
    "secretbox"
  ],
  "homepage": "https://github.com/sebastienrousseau/crypto-service/tree/main/packages/crypto-typeorm",
  "publishConfig": {
    "access": "public"
  },
  "private": false
}
