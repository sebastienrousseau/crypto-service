{
  "name": "@sebastienrousseau/crypto-edge",
  "version": "0.0.3",
  "description": "Edge and serverless runtime adapter for crypto-lib -- runs on Cloudflare Workers, Vercel Edge, Deno, Bun, and browsers.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://crypto-service.co",
  "repository": {
    "directory": "packages/crypto-edge",
    "type": "git",
    "url": "git@github.com:sebastienrousseau/crypto-service.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/crypto-service/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "test": "c8 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --cache --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@sebastienrousseau/crypto-lib": "workspace:*"
  },
  "devDependencies": {
    "@sebastienrousseau/mocha-config": "^0.0.5",
    "@types/chai": "^4.3.7",
    "@types/chai-as-promised": "^7.1.6",
    "@types/mocha": "^10.0.2",
    "@types/node": "^22.0.0",
    "c8": "^10.1.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^10.8.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "crypto",
    "edge",
    "cloudflare-workers",
    "vercel-edge",
    "deno",
    "bun",
    "webcrypto",
    "serverless",
    "runtime-detection"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
