{
  "name": "@sebastienrousseau/crypto-lib",
  "version": "0.0.3",
  "description": "Crypto Lib is a powerful intuitive cryptographic JavaScript library that encapsulates common algorithms, functions and provides an interface for low-level cryptographic operations.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://crypto-lib.io",
  "repository": {
    "directory": "packages/crypto-lib",
    "type": "git",
    "url": "git@github.com:sebastienrousseau/crypto-service.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/crypto-service/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "cryptolib": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --cache --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "start": "node dist/index.js",
    "test": "mkdir -p \"${TMPDIR:-/tmp}/crypto-lib-test-out\" && CRYPTO_KEY_DIR=\"$(pwd)/__tests__/fixtures/keys\" CRYPTO_KEY_OUT_DIR=\"${TMPDIR:-/tmp}/crypto-lib-test-out\" CRYPTO_DATA_DIR=\"${TMPDIR:-/tmp}/crypto-lib-test-out\" c8 --check-coverage --lines 100 --branches 99.5 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@noble/post-quantum": "^0.7.0",
    "@openpgp/web-stream-tools": "^0.3.1",
    "openpgp": "^6.3.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.7",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.2",
    "@types/node": "^26.2.0",
    "c8": "^10.1.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^10.8.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "crypto-library",
    "cryptography",
    "openpgp",
    "encryption",
    "decryption",
    "ecc",
    "rsa"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
