{
  "name": "@sebastienrousseau/crypto-vue",
  "version": "0.0.3",
  "description": "Vue 3 composables for client-side cryptography — key generation, encryption, signing, and hashing with reactive state.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://crypto-service.co",
  "repository": {
    "directory": "packages/crypto-vue",
    "type": "git",
    "url": "git@github.com:sebastienrousseau/crypto-service.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/crypto-service/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rimraf ./coverage ./dist ./docs",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --reporter=lcov --reporter=text mocha --config=.mocharc.cjs",
    "docs": "typedoc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --cache --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@sebastienrousseau/crypto-lib": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@sebastienrousseau/mocha-config": "^0.0.5",
    "@types/chai": "^4.3.7",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.2",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "mocha": "^11.8.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "vue": "^3.3.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "cryptography",
    "encryption",
    "signing",
    "hashing",
    "post-quantum"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
